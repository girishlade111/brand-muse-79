# Database Provider Selection (neon | supabase)
DATABASE_PROVIDER="neon"
DATABASE_URL="postgres://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL="postgres://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"

# Supabase Compatibility Layer (Optional when DATABASE_PROVIDER=supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_URL="postgres://postgres.yourproject:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Object Storage Provider Selection (r2 | s3 | supabase)
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="brand-assets"
R2_PUBLIC_URL="https://assets.yourbrand.com"

# Upstash Redis (Edge Multi-Tiered Caching Layer)
# HTTP REST endpoint & token for server-side cache (Google Fonts 7d, Scraped URLs 24h, Brand Kits 1h)
# Falls back to in-memory L1 cache in local dev.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# Client-side public asset base (mirrors R2_PUBLIC_URL for Vite).
# Read by kit/studio components to resolve `storage_path` -> public URL.
VITE_R2_PUBLIC_URL="https://assets.yourbrand.com"

# Lovable AI Gateway — used for structured extraction and image prompts.
# Read by src/server/ai.server.ts and src/lib/logo-variants.functions.ts.
LOVABLE_API_KEY="your-lovable-api-key"

# Firecrawl — richer scraping (markdown, links, branding metadata).
# Accepts either a real Firecrawl key (fc-*) or a Lovable connection key
# (lovc_*), which is paired with LOVABLE_API_KEY automatically.
# Read by src/server/ai.server.ts. Optional: without it the pipeline falls
# back to the built-in direct HTML scraper.
FIRECRAWL_API_KEY="your-firecrawl-api-key"

# Cron authentication for scheduled endpoints (see
# src/server/cron-auth.server.ts). LOVABLE_CRON_SECRET_PREVIOUS is
# optional and only used to accept a rotating secret during rollout.
LOVABLE_CRON_SECRET="your-cron-secret"
LOVABLE_CRON_SECRET_PREVIOUS=""

# Cloudflare Custom Hostnames (SSL for SaaS)
# Enables automated custom domain routing & SSL certificate provisioning (e.g. brand.client.com).
# Read by src/server/cloudflare-saas.server.ts. Optional in local dev (runs in simulation mode).
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_CNAME_TARGET="cname.branddna.app"

# Upstash QStash (Serverless Background Job Queue)
# Decouples multi-step extraction workflows (<15s per step) with jittered retries.
# Read by src/server/job-queue.server.ts. Optional: falls back to decoupled microtask execution in local dev.
QSTASH_TOKEN="your-upstash-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-signing-key"
QSTASH_URL="https://qstash.upstash.io/v2/publish"
APP_BASE_URL="https://branddna.app"

# Playwright only (optional): point e2e runs at an existing Chrome install.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"


